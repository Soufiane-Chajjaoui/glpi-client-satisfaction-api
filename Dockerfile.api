FROM python:3.12-slim

WORKDIR /app

COPY requirements-prod.txt .
RUN pip install --no-cache-dir -r requirements-prod.txt

COPY models/ models/
COPY api/ api/
COPY lib/ lib/
COPY apps/ apps/
COPY setup/ setup/
COPY pipeline.py scheduler.py ./

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
